---
const { slug } = Astro.props;
---
<div class="reaction" data-slug={slug}>
  <button type="button" class="reaction-btn" aria-label="喝一杯">
    <span class="reaction-emoji" aria-hidden="true">🍺</span>
    <span class="reaction-count">–</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.reaction').forEach((root) => {
    const slug = root.dataset.slug!;
    const btn = root.querySelector<HTMLButtonElement>('.reaction-btn')!;
    const countEl = root.querySelector<HTMLElement>('.reaction-count')!;
    const storageKey = `reacted:${slug}`;
    const endpoint = '/api/reaction';

    // 載入目前數量
    fetch(`${endpoint}?slug=${encodeURIComponent(slug)}`)
      .then((r) => r.json())
      .then((d) => { countEl.textContent = String(d.count); })
      .catch(() => { countEl.textContent = '0'; });

    if (localStorage.getItem(storageKey) === '1') {
      btn.classList.add('is-reacted');
    }

    btn.addEventListener('click', async () => {
      if (localStorage.getItem(storageKey) === '1') return;
      try {
        const r = await fetch(`${endpoint}?slug=${encodeURIComponent(slug)}`, { method: 'POST' });
        const d = await r.json();
        countEl.textContent = String(d.count);
        localStorage.setItem(storageKey, '1');
        btn.classList.add('is-reacted');
      } catch {
        // 失敗時靜默處理，不再顯示 toast
      }
    });
  });
</script>
