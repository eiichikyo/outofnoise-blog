---
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import ThemeInit from '../../components/ThemeInit.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 依 id 產生固定的水平偏移（-12px 到 +12px），同一篇每次建置都一樣
function hash(str: string): number {
  let h = 0;
  for (const c of str) h = (h * 31 + c.charCodeAt(0)) | 0;
  return Math.abs(h);
}
const jitter = (id: string) => (hash(id) % 25) - 12;
---
<!doctype html>
<html lang="zh">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Posts</title>
  <ThemeInit />
</head>
<body>

<header class="site-top">
	<a href="/" class="home-link" aria-label="回主頁" title="回主頁">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none"
			stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M3 10.5 12 3l9 7.5" />
			<path d="M5 9.5V21h14V9.5" />
		</svg>
	</a>
	<ThemeToggle />
</header>


<main class="posts">
  <h1>Posts</h1>

  <ol class="timeline">
    {posts.map((post, i) => {
      const next = posts[i + 1];
      const x1 = 50 + jitter(post.id);
      const x2 = next ? 50 + jitter(next.id) : x1;
      return (
        <li class="tl-item">
          {next && (
            <svg class="tl-link" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <line x1={x1} y1="0" x2={x2} y2="100" />
            </svg>
          )}

          <time class="tl-date" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-TW')}
          </time>

          <span class="tl-dot" style={`--jx:${jitter(post.id)}px`} aria-hidden="true"></span>

          <div class="tl-body">
            <a class="tl-title" href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
            <p class="tl-desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <p class="tl-tags">
                {post.data.tags.map((tag) => (
                  <a class="tl-tag" href={`/tags/${tag}`}>#{tag}</a>
                ))}
              </p>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</main>

</body>
</html>