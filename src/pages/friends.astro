---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const friends = [
  { name: "Curly Sheep", url: "https://curly-sheep.netlify.app/", desc: "卷毛羊的赛博羊圈！" },
  // 新增友链示例：
  // { name: "名稱", url: "https://example.com/", desc: "簡介" },
];
---
<!doctype html>
<html lang="zh">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<title>友鏈 | 記憶消融前。</title>
<ThemeInit />
<style>
body{
  margin:0;
  background:var(--bg-color);
  color:var(--fg);
  font-family:var(--font-sans);
  padding:clamp(24px, 6vw, 60px) clamp(16px, 5vw, 40px);
  box-sizing:border-box;
}
main{
  width:100%;
  max-width:720px;
  margin:0 auto;
  padding-top:24px;
  box-sizing:border-box;
}
h1{font-weight:700;letter-spacing:4px;margin:0 0 10px;color:var(--heading);font-family:var(--font-title);font-size:clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);}
.welcome{margin:0 0 24px 0;opacity:.6;font-size:.85rem;}
.friend-list{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill, minmax(min(220px, 100%), 1fr));gap:16px;margin-bottom:50px;}
.friend-list li{border:1px solid var(--border);border-radius:10px;background:var(--pill-bg);transition:.3s;}
.friend-list li:hover{border-color:var(--accent);transform:translateY(-2px);}
.friend-list a{display:block;height:100%;box-sizing:border-box;padding:16px;color:var(--fg);text-decoration:none;word-break:break-word;}
.friend-name{display:block;font-size:1.1rem;font-family:var(--font-title);font-weight:700;}
.friend-desc{display:block;margin-top:8px;opacity:.5;font-size:.85rem;line-height:1.5;}
.empty{opacity:.5;margin-bottom:50px;}
h2{font-weight:700;font-size:1.2rem;margin-bottom:20px;color:var(--heading);font-family:var(--font-title);}
form{display:flex;flex-direction:column;gap:14px;width:100%;max-width:420px;}
label{font-size:.85rem;opacity:.7;margin-bottom:4px;display:block;}
input{
  width:100%;
  padding:10px 12px;
  border:1px solid var(--border);
  border-radius:8px;
  background:var(--pill-bg);
  color:var(--fg);
  font-size:.95rem;
  box-sizing:border-box;
}
input:focus{outline:none;border-color:var(--accent);}
button{
  padding:10px 20px;
  border:1px solid var(--border);
  border-radius:8px;
  background:var(--pill-bg);
  color:var(--fg);
  font-size:.95rem;
  cursor:pointer;
  transition:.3s;
  width:fit-content;
}
button:hover{background:var(--hover-bg);color:var(--hover-fg);border-color:var(--hover-bg);}
.hidden{display:none;}
.my-info{margin-top:40px;padding-top:20px;border-top:1px solid var(--border);word-break:break-word;}
.my-info p{margin:4px 0;opacity:.7;font-size:.9rem;}
.my-info a{color:var(--fg);}

@media (max-width: 600px){
  .friend-list{grid-template-columns:1fr;}
  main{padding-top:56px;}
  form{max-width:100%;}
}
</style>
</head>
<body>
<header class="site-top">
	<a href="/" class="home-link" aria-label="回主頁" title="回主頁">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none"
			stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M3 10.5 12 3l9 7.5" />
			<path d="M5 9.5V21h14V9.5" />
		</svg>
	</a>
	<ThemeToggle />
</header>

<main>
<h1>友鏈</h1>

<p class="welcome">歡迎大家來交換友鏈w！</p>

{friends.length === 0 && <p class="empty">暫無友鏈</p>}
<ul class="friend-list">
  {friends.map(friend => (
    <li>
      <a href={friend.url} target="_blank" rel="noopener noreferrer">
        <span class="friend-name">{friend.name}</span>
        <span class="friend-desc">{friend.desc}</span>
      </a>
    </li>
  ))}
</ul>

<h2>提交友鏈</h2>
<form name="friend-links" method="POST" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="friend-links" />
  <p class="hidden">
    <label>不要填這欄：<input name="bot-field" /></label>
  </p>
  <div>
    <label for="name">名稱</label>
    <input type="text" id="name" name="name" required />
  </div>
  <div>
    <label for="url">網址</label>
    <input type="url" id="url" name="url" placeholder="https://" required />
  </div>
  <div>
    <label for="desc">簡介</label>
    <input type="text" id="desc" name="desc" required />
  </div>
  <button type="submit">送出</button>
</form>

<div class="my-info">
  <p>本站友鏈信息：</p>
  <p>名稱：記憶消融前。</p>
  <p>網址：<a href="https://outofnoise.netlify.app/" target="_blank">https://outofnoise.netlify.app/</a></p>
  <p>簡介：ふとした景色が頭に残るような事、大切にするって決めたんだ </p>
</div>

</main>
</body>
</html>