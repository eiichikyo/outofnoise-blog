---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const posts = await getCollection('blog');
const totalChars = posts.reduce((sum, post) => {
  const plainText = post.body?.replace(/[#*`_>\-\[\]!]/g, "") ?? "";
  return sum + plainText.replace(/\s/g, "").length;
}, 0);

// 標題逐字拆開，讓每個字可以各自蒸發
const siteTitle = '記憶消融前。';
const chars = [...siteTitle];
---
<!doctype html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{siteTitle}</title>
  <ThemeInit />
</head>
<body class="page-home">

<header class="site-top">
  <ThemeToggle />
  <a href="/rss.xml" class="rss-link" title="RSS Feed" target="_blank" aria-label="RSS Feed">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="5" cy="19" r="2" fill="currentColor"/>
      <path d="M4 4C12.8366 4 20 11.1634 20 20H16C16 13.3726 10.6274 8 4 8V4Z" fill="currentColor"/>
      <path d="M4 11C9.52285 11 14 15.4772 14 21H10C10 17.6863 7.31371 15 4 15V11Z" fill="currentColor"/>
    </svg>
  </a>
</header>

<main class="home">
  <h1 class="evaporate" aria-label={siteTitle}>
    {chars.map((c, i) => (
      <span class="ch" style={`--i:${i}`} aria-hidden="true">{c}</span>
    ))}
  </h1>

  <nav class="nav">
    <a href="/blog">📝 Posts</a>
    <a href="/friends">🔗 友鏈</a>
  </nav>

  <div class="stats">
    <div id="days-running">Running ... days</div>
    <div>{posts.length} posts · {totalChars} characters</div>
  </div>

  <!-- About me 等之後的板塊放在這裡 -->
  <section class="home-section" id="about" aria-label="About me"></section>
</main>

<script>
  // 2026-07-04 台北時間 00:00
  const createdAt = new Date("2026-07-04T00:00:00+08:00");
  const now = new Date();
  const daysRunning = Math.floor(
    (now.getTime() - createdAt.getTime()) / (1000 * 60 * 60 * 24)
  );
  const el = document.getElementById("days-running");
  if (el) el.textContent = `Running ${daysRunning} days`;
</script>
</body>
</html>